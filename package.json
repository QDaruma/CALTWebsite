{
  "name": "calt-task-builder",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Interactive builder that scaffolds a ready-to-run CALT task as a downloadable ZIP.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:docs": "tsc --noEmit && vite build --outDir ../docs/builder --emptyOutDir",
    "preview": "vite preview",
    "bundle": "node scripts/bundle-tasks.mjs",
    "sync:tasks": "node scripts/sync-tasks.mjs"
  },
  "dependencies": {
    "@radix-ui/react-popover": "^1.1.2",
    "@radix-ui/react-tooltip": "^1.1.4",
    "framer-motion": "^11.11.17",
    "jszip": "^3.10.1",
    "lucide-react": "^0.460.0",
    "prismjs": "^1.29.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/prismjs": "^1.26.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
